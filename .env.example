# ==============================================================================
# Supply Chain P2P Enterprise Platform - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure secrets before deploying to production.
# NEVER commit real production secrets to version control.

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=supplychain_db
POSTGRES_USER=supplychain
POSTGRES_PASSWORD=your_strong_random_db_password_here
POSTGRES_PORT=5433

# RabbitMQ AMQP Broker
RABBITMQ_USER=supplychain_amqp
RABBITMQ_PASSWORD=your_strong_amqp_password_here

# JWT Authentication & Authorization (RFC 7519)
# Must be at least 256 bits (32 characters or random base64 string)
JWT_SECRET=your_production_256_bit_cryptographic_secret_key_minimum_32_chars

# Stripe Gateway (ADR-010)
STRIPE_API_KEY=sk_live_replace_with_real_key_or_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_webhook_secret
STRIPE_CONNECT_ACCOUNT_ID=acct_replace_with_connect_account

# DevSecOps RBAC Security (Zero-Trust)
SECURITY_MOCK_HEADERS_ENABLED=false
SECURITY_ALLOW_ANONYMOUS_FALLBACK=false
SECURITY_SEED_DEFAULT_USERS=false

