<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="SupplyChainPU" transaction-type="RESOURCE_LOCAL">
        <description>Supply Chain and Vendor Management Persistence Unit</description>
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        
        <class>ro.uaic.feaa.sdbis.supplychain.comenzi.domain.ComandaAprovizionare</class>
        <class>ro.uaic.feaa.sdbis.supplychain.comenzi.domain.Lot</class>
        <class>ro.uaic.feaa.sdbis.supplychain.calitate.domain.Furnizor</class>
        <class>ro.uaic.feaa.sdbis.supplychain.calitate.domain.ScorecardLunar</class>
        <class>ro.uaic.feaa.sdbis.supplychain.calitate.domain.InspectorCalitate</class>
        <class>ro.uaic.feaa.sdbis.supplychain.calitate.domain.InspectieCalitate</class>
        <class>ro.uaic.feaa.sdbis.supplychain.calitate.domain.RaportNeconformitate</class>
        <class>ro.uaic.feaa.sdbis.supplychain.facturi.domain.FacturaFurnizor</class>
        <class>ro.uaic.feaa.sdbis.supplychain.facturi.domain.NIR</class>
        <class>ro.uaic.feaa.sdbis.supplychain.facturi.domain.OrdinPlata</class>
        <class>ro.uaic.feaa.sdbis.supplychain.shared.OutboxEventEntity</class>
        <class>ro.uaic.feaa.sdbis.supplychain.shared.InboxEventEntity</class>
        <class>ro.uaic.feaa.sdbis.supplychain.shared.AuditLogEntry</class>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:supplychaindb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
